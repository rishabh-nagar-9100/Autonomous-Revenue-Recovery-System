# Autonomous AI Revenue Recovery System - Configuration Template

# 1. Execution Mode Configuration
# Options: 'mock' (local deterministic synthetic testing) or 'sandbox' (genuine Razorpay Test Mode API)
EXECUTION_MODE=sandbox

# 2. Razorpay Test Mode API Credentials (Required for Live Test Mode payment link creation & webhook verification)
# Generate key ID & secret from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 3. Optional Anthropic API Key (Required for Tier 2 LLM Root Cause Diagnosis fallback on unmapped errors)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. Feature Flags
B2B_ENABLED=true
INFO_GATHERING_ENABLED=true
VOICE_ENABLED=true
FAULT_INJECTION_ENABLED=false

# Controls whether Razorpay API failure falls back to mock payment link in demo mode
DEMO_FALLBACK_TO_MOCK=false

# 5. Operational Safety Thresholds
INFO_RECOVERY_WINDOW_DAYS=7
MAX_RECONCILIATION_ATTEMPTS=3
MAX_RECONCILIATION_HOURS=24
